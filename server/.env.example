NODE_ENV=development
PORT=5000

ALLOWED_ORIGIN=http://localhost:5173
APP_BASE_URL=http://localhost:5173
CLIENT_URL=http://localhost:5173

# Shopora authentication
JWT_ACCESS_SECRET=replace_me
JWT_REFRESH_SECRET=replace_me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
ENABLE_LEGACY_FIREBASE_AUTH=true

# OAuth providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/github/callback

# Server-only product photo search
PEXELS_API_KEY=

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB=Shopora

# Optional DNS override
DNS_SERVERS=8.8.8.8,8.8.4.4

# Admin
ADMIN_UID=your_admin_uid
SUPER_ADMIN_UID=your_super_admin_uid
ADMIN_LOGIN_EMAIL=admin@example.com
ADMIN_LOGIN_PASSWORD=change_me
ADMIN_SESSION_SECRET=generate_a_long_random_secret

# Optional local admin
# DEV_ADMIN_EMAIL=admin@example.com
# DEV_ADMIN_UID=dev-admin-uid

# Cloudinary - optional
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Razorpay
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Temporary migration fallback; remove after production JWT migration validation
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# ExerciseDB / RapidAPI - optional
RAPIDAPI_KEY=your_rapidapi_key
RAPIDAPI_HOST=exercisedb.p.rapidapi.com

# SMTP - optional
SMTP_HOST=your_smtp_host
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_email
SMTP_PASS=your_smtp_password
SMTP_FROM=noreply@shopora.app
