# Backend
VITE_API_URL=http://localhost:5000

# Firebase Web App
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Razorpay - public key only
VITE_RAZORPAY_KEY_ID=your_razorpay_key_id

# Admin
VITE_ADMIN_UID=your_admin_uid
VITE_SUPER_ADMIN_UID=your_super_admin_uid

# Optional local development admin
VITE_DEV_ADMIN_EMAIL=admin@example.com
VITE_DEV_ADMIN_UID=dev-admin-uid

# Optional support address displayed in the UI
VITE_SUPPORT_EMAIL=
